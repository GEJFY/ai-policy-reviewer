# =============================================================================
# AI Policy Reviewer - 環境設定
# =============================================================================
# このファイルをコピーして .env を作成: cp .env.example .env

# =============================================================================
# LLM Provider Selection
# =============================================================================
# 使用するLLMプロバイダー: azure, aws_bedrock, gcp_vertex, local
LLM_PROVIDER=azure
# 使用するモデル（プロバイダー別のモデルIDを指定）
LLM_MODEL=gpt-5.2
# モデルティア（precision / balanced / cost_effective）
# 設定するとプロバイダーのデフォルトモデルが自動選択される（LLM_MODELより優先）
# LLM_TIER=balanced

# =============================================================================
# Embedding Provider Selection
# =============================================================================
# 使用するEmbeddingプロバイダー: azure_openai, aws_bedrock, gcp_vertex, local
EMBEDDING_PROVIDER=azure_openai
# AWS Bedrock Embedding (Titan)
# AWS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# GCP Vertex AI Embedding
# GCP_VERTEX_EMBEDDING_MODEL=text-embedding-005
# Ollama Embedding (Local)
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Azure OpenAI / Azure AI Foundry
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5-2
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_USE_V1_API=true
# モデル例:
#   Precision: gpt-5.2, gpt-5.2-codex, claude-opus-4-6
#   Balanced:  gpt-5-mini, claude-sonnet-4-5
#   Cost:     gpt-5-nano, claude-haiku-4-5

# =============================================================================
# AWS Bedrock
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# モデル例（Inference Profile ID形式）:
#   Precision: us.anthropic.claude-opus-4-6-v1, us.amazon.nova-premier-v1:0
#   Balanced:  us.anthropic.claude-sonnet-4-5-20250929-v1:0, us.amazon.nova-pro-v1:0
#   Cost:     us.anthropic.claude-haiku-4-5-20251001-v1:0, us.amazon.nova-micro-v1:0

# =============================================================================
# GCP Vertex AI
# =============================================================================
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=global
GCP_CREDENTIALS_PATH=/path/to/service-account.json
GCP_VERTEX_MODEL=gemini-3-flash-preview
# モデル例:
#   Precision: gemini-3-pro-preview, claude-opus-4-6
#   Balanced:  gemini-3-flash-preview, claude-sonnet-4-5
#   Cost:     claude-haiku-4-5

# =============================================================================
# Local LLM (Ollama)
# =============================================================================
# LLM_PROVIDER=local で使用
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=schroneko/gemma-2-2b-jpn-it
# モデル例:
#   qwen2.5:3b (多言語), schroneko/gemma-2-2b-jpn-it (日本語最適化)

# =============================================================================
# OCR Provider Selection
# =============================================================================
# 使用するOCRプロバイダー: azure_doc_intel, tesseract, aws_tesseract
OCR_PROVIDER=azure_doc_intel

# =============================================================================
# Azure Document Intelligence (OCR)
# =============================================================================
AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-api-key

# =============================================================================
# Tesseract OCR (Local)
# =============================================================================
# OCR_PROVIDER=tesseract で使用
# Tesseractの実行パス（空の場合はPATHを検索）
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=jpn+eng

# =============================================================================
# AWS Tesseract OCR (Remote)
# =============================================================================
# OCR_PROVIDER=aws_tesseract で使用
# AWS_TESSERACT_ENDPOINT=https://your-api-gateway.execute-api.us-east-1.amazonaws.com/prod

# =============================================================================
# Database
# =============================================================================
# SQLite（ローカル開発）
DATABASE_URL=sqlite:///./data/policy_review.db
# PostgreSQL（Docker Compose local-llm / cloud-dev プロファイル）
# DATABASE_URL=postgresql://app:dev-password@localhost:5432/policy_review
# PostgreSQL（AWS RDS）
# DATABASE_URL=postgresql://app:password@your-rds-endpoint:5432/policy_review
# PostgreSQL（GCP Cloud SQL）
# DATABASE_URL=postgresql://app:password@/policy_review?host=/cloudsql/project:region:instance

# =============================================================================
# App
# =============================================================================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true
